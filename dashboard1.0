<!-- ==========================================================
     Projeto: PLC VMI-IOT
     Arquivo: dashboard.html
     Versão: 1.0.0 (Menu principal, Gráficos 24h+Zoom, Valores com Status)
     Descrição: Dashboard web com ambientes separados, visualização histórica
                e monitoramento de atualidade dos dados.
     ========================================================== -->
<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>VMI-IOT Dashboard</title>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1"></script>
  <script src="https://cdn.jsdelivr.net/npm/chartjs-adapter-date-fns@3.0.0"></script>
  <script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-zoom@2.0.1"></script>
  <style>
    :root {
      --bg: #0f172a;
      --surface: #1e293b;
      --surface-hover: #334155;
      --text: #f8fafc;
      --text-muted: #94a3b8;
      --primary: #3b82f6;
      --success: #22c55e;
      --danger: #ef4444;
      --border: #334155;
      --radius: 12px;
      --shadow: 0 4px 12px rgba(0,0,0,0.4);
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: 'Segoe UI', system-ui, sans-serif;
      background: var(--bg);
      color: var(--text);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }
    header {
      background: var(--surface);
      padding: 1rem 2rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-bottom: 1px solid var(--border);
      box-shadow: var(--shadow);
    }
    header h1 { font-size: 1.4rem; font-weight: 600; }
    nav { display: flex; gap: 0.5rem; }
    .nav-btn {
      background: transparent;
      border: 1px solid var(--border);
      color: var(--text-muted);
      padding: 0.6rem 1.2rem;
      border-radius: var(--radius);
      cursor: pointer;
      font-weight: 500;
      transition: all 0.2s;
    }
    .nav-btn:hover { background: var(--surface-hover); color: var(--text); }
    .nav-btn.active { background: var(--primary); color: white; border-color: var(--primary); }
    main { flex: 1; padding: 2rem; max-width: 1400px; margin: 0 auto; width: 100%; }
    .view { display: none; animation: fadeIn 0.3s ease; }
    .view.active { display: block; }
    @keyframes fadeIn { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }

    /* Controls */
    .controls {
      display: flex; gap: 1rem; margin-bottom: 1.5rem; flex-wrap: wrap; align-items: center;
    }
    select, button {
      background: var(--surface); color: var(--text); border: 1px solid var(--border);
      padding: 0.6rem 1rem; border-radius: var(--radius); font-size: 0.95rem;
    }
    button { cursor: pointer; transition: background 0.2s; }
    button:hover { background: var(--surface-hover); }
    .chart-container {
      background: var(--surface); border-radius: var(--radius); padding: 1.5rem;
      box-shadow: var(--shadow); position: relative; height: 450px;
    }
    .zoom-controls {
      position: absolute; top: 10px; right: 10px; display: flex; gap: 0.5rem; z-index: 10;
    }
    .zoom-btn { background: var(--surface-hover); border: none; width: 32px; height: 32px; border-radius: 50%; font-weight: bold; }

    /* Values Grid */
    .values-grid {
      display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 1.2rem;
    }
    .value-card {
      background: var(--surface); border-radius: var(--radius); padding: 1.2rem;
      box-shadow: var(--shadow); border-left: 4px solid var(--border); transition: transform 0.2s;
    }
    .value-card:hover { transform: translateY(-3px); }
    .value-card h3 { font-size: 1rem; color: var(--text-muted); margin-bottom: 0.5rem; }
    .value-card .value { font-size: 1.8rem; font-weight: 700; margin-bottom: 0.3rem; }
    .value-card .meta { font-size: 0.85rem; color: var(--text-muted); display: flex; justify-content: space-between; align-items: center; }
    .status-dot { width: 10px; height: 10px; border-radius: 50%; display: inline-block; margin-right: 6px; }
    .status-dot.green { background: var(--success); box-shadow: 0 0 6px var(--success); }
    .status-dot.red { background: var(--danger); box-shadow: 0 0 6px var(--danger); }
    .refresh-info { text-align: right; margin-top: 1rem; color: var(--text-muted); font-size: 0.9rem; }
    .loading { text-align: center; padding: 2rem; color: var(--text-muted); }
    .error { background: #451a1a; color: #fca5a5; padding: 1rem; border-radius: var(--radius); margin-top: 1rem; }
  </style>
</head>
<body>
  <header>
    <h1>📡 VMI-IOT Monitor</h1>
    <nav>
      <button onclick="showView('graphs')" class="nav-btn active" id="btn-graphs">📊 Gráficos</button>
      <button onclick="showView('values')" class="nav-btn" id="btn-values">📦 Valores Atuais</button>
    </nav>
  </header>

  <main>
    <!-- AMBIENTE: GRÁFICOS -->
    <section id="view-graphs" class="view active">
      <div class="controls">
        <select id="sel-machine"><option value="MACH_01">MACH_01</option></select>
        <select id="sel-tag">
          <option value="_IO_EM_DI_00">_IO_EM_DI_00</option>
          <option value="QOP_AV_CYCLES">QOP_AV_CYCLES</option>
          <option value="VMI_BHV_TEST">VMI_BHV_TEST</option>
          <option value="QOP_ERROR_MESSAGE">QOP_ERROR_MESSAGE</option>
          <option value="AUX_AV_CUSH_GUM_TEMP">AUX_AV_CUSH_GUM_TEMP</option>
          <option value="QOP_AV_HOURS">QOP_AV_HOURS</option>
        </select>
        <button onclick="loadGraph()">🔄 Atualizar Gráfico</button>
      </div>
      <div class="chart-container">
        <div class="zoom-controls">
          <button class="zoom-btn" onclick="zoomIn()">+</button>
          <button class="zoom-btn" onclick="zoomOut()">−</button>
          <button class="zoom-btn" onclick="resetZoom()">⟲</button>
        </div>
        <canvas id="mainChart"></canvas>
        <div id="graph-error" class="error" style="display:none;"></div>
      </div>
    </section>

    <!-- AMBIENTE: VALORES -->
    <section id="view-values" class="view">
      <div class="controls">
        <button onclick="loadValues()">🔄 Atualizar Valores</button>
        <span style="color: var(--text-muted); margin-left: 1rem;">Auto-atualização: 60s | Status: 🟢 < 2min | 🔴 > 2min</span>
      </div>
      <div id="values-grid" class="values-grid"></div>
      <div class="refresh-info" id="values-refresh"></div>
    </section>
  </main>

  <script>
    // CONFIGURAÇÃO
    const API_BASE = "https://vmi-iot-cloud.onrender.com";
    const MACHINE_ID = "MACH_01";
    const TAGS = ['_IO_EM_DI_00', 'QOP_AV_CYCLES', 'VMI_BHV_TEST', 'QOP_ERROR_MESSAGE', 'AUX_AV_CUSH_GUM_TEMP', 'QOP_AV_HOURS'];
    let chart = null;
    let valuesInterval = null;

    // NAVEGAÇÃO
    function showView(view) {
      document.querySelectorAll('.view').forEach(v => v.classList.remove('active'));
      document.querySelectorAll('.nav-btn').forEach(b => b.classList.remove('active'));
      document.getElementById(`view-${view}`).classList.add('active');
      document.getElementById(`btn-${view}`).classList.add('active');
      if (view === 'values') loadValues();
    }

    // GRÁFICO
    async function loadGraph() {
      const tag = document.getElementById('sel-tag').value;
      const machine = document.getElementById('sel-machine').value;
      const errorDiv = document.getElementById('graph-error');
      errorDiv.style.display = 'none';

      try {
        const res = await fetch(`${API_BASE}/api/history/${machine}?tag=${tag}`);
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        const data = await res.json();

        if (!data.data || data.data.length === 0) {
          errorDiv.textContent = "⚠️ Nenhum dado encontrado para esta tag.";
          errorDiv.style.display = 'block';
          if (chart) chart.data.datasets[0].data = [];
          chart.update();
          return;
        }

        const points = data.data.map(d => ({ x: new Date(d.time), y: d.value }));
        if (!chart) {
          const ctx = document.getElementById('mainChart').getContext('2d');
          chart = new Chart(ctx, {
            type: 'line',
            data: { datasets: [{ label: tag, data: points, borderColor: '#3b82f6', backgroundColor: 'rgba(59,130,246,0.1)', fill: true, tension: 0.3, pointRadius: 3 }] },
            options: {
              responsive: true,
              maintainAspectRatio: false,
              scales: {
                x: {
                  type: 'time',
                  time: { unit: 'hour', displayFormats: { hour: 'HH:mm' } },
                  suggestedMin: Date.now() - 24*60*60*1000,
                  suggestedMax: Date.now(),
                  grid: { color: '#334155' }
                },
                y: { grid: { color: '#334155' } }
              },
              plugins: {
                zoom: {
                  pan: { enabled: true, mode: 'x' },
                  zoom: { wheel: { enabled: true }, pinch: { enabled: true }, mode: 'x' }
                },
                legend: { display: false }
              }
            }
          });
        } else {
          chart.data.datasets[0].data = points;
          chart.data.datasets[0].label = tag;
          chart.options.scales.x.suggestedMin = Date.now() - 24*60*60*1000;
          chart.options.scales.x.suggestedMax = Date.now();
          chart.update();
        }
      } catch (err) {
        errorDiv.textContent = `❌ Erro ao carregar dados: ${err.message}`;
        errorDiv.style.display = 'block';
      }
    }

    function zoomIn() { if(chart) chart.zoom({ x: 1.2 }); }
    function zoomOut() { if(chart) chart.zoom({ x: 0.8 }); }
    function resetZoom() { if(chart) chart.resetZoom(); }

    // VALORES
    async function loadValues() {
      const grid = document.getElementById('values-grid');
      grid.innerHTML = '<div class="loading">Carregando valores...</div>';

      try {
        const promises = TAGS.map(tag => fetch(`${API_BASE}/api/history/${MACHINE_ID}?tag=${tag}`).then(r => r.json()));
        const results = await Promise.allSettled(promises);

        grid.innerHTML = '';
        results.forEach((res, i) => {
          const tag = TAGS[i];
          const card = document.createElement('div');
          card.className = 'value-card';
          let value = 'N/A', lastTime = '-', status = 'red', statusText = 'Desatualizado';

          if (res.status === 'fulfilled' && res.value.data && res.value.data.length > 0) {
            const latest = res.value.data[res.value.data.length - 1];
            value = latest.value;
            lastTime = new Date(latest.time).toLocaleTimeString('pt-BR');
            const ageSec = (Date.now() - new Date(latest.time)) / 1000;
            status = ageSec < 120 ? 'green' : 'red';
            statusText = ageSec < 120 ? 'Atualizado' : 'Desatualizado';
          } else {
            status = 'red';
            statusText = 'Sem dados';
          }

          card.innerHTML = `
            <h3>${tag}</h3>
            <div class="value">${value}</div>
            <div class="meta">
              <span><span class="status-dot ${status}"></span>${statusText}</span>
              <span>Último: ${lastTime}</span>
            </div>
          `;
          grid.appendChild(card);
        });

        document.getElementById('values-refresh').textContent = `Atualizado em: ${new Date().toLocaleTimeString('pt-BR')}`;
      } catch (err) {
        grid.innerHTML = `<div class="error">❌ Erro ao carregar valores: ${err.message}</div>`;
      }
    }

    // INICIALIZAÇÃO
    document.addEventListener('DOMContentLoaded', () => {
      loadGraph();
      // Auto-refresh valores a cada 60s
      valuesInterval = setInterval(loadValues, 60000);
    });
  </script>
</body>
</html>